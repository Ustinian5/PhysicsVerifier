# Verifier profile. Select the catalog explicitly for every experiment.
# This is the current 1123-rule development baseline; the 4875-rule backfilled
# catalog is a rejected historical ablation and must not be an implicit default.
PHYSICSVERIFIER_UNIFIED_RULES=catalogs/rules_unified_3000.json
PHYSICSVERIFIER_UNIFIED_RETRIEVAL_MODE=semantic
PHYSICSVERIFIER_SEMANTIC_OUTPUT_ADAPTER=forced_tool_call
PHYSICSVERIFIER_SEMANTIC_JSON_ATTEMPTS=3
PHYSICSVERIFIER_UNIFIED_RULE_TOP_N=6
PHYSICSVERIFIER_SYMBOLIC_ENABLED=0
PHYSICSVERIFIER_LLM_MODEL=qwen3-30b-a3b-instruct-2507
PHYSICSVERIFIER_CHECKER_GATE_MODE=legacy
PHYSICSVERIFIER_CHECKER_JSON_ATTEMPTS=3
PHYSICSVERIFIER_PRECISION_MODE=strict
PHYSICSVERIFIER_MAX_DIAGNOSTICS_PER_SAMPLE=12
PHYSICSVERIFIER_MAX_DIAGNOSTICS_PER_PARAGRAPH=2
PHYSICSVERIFIER_ENABLE_LLM_CACHE=0
PHYSICSVERIFIER_REQUIRE_PROVIDER_IDENTITY=1

# OpenAI-compatible semantic checker endpoint
OPENAI_BASE_URL=http://127.0.0.1:8766/v1
OPENAI_API_KEY=EMPTY

# OpenRLHF reward endpoint
PHYSICS_REWARD_URL=http://127.0.0.1:8770/get_reward
PHYSICS_REWARD_MODE=answer_low_verifier
# Abort a reward batch when the Verifier is incomplete; use zero_reward only
# when an experiment explicitly prefers neutral fallback over fail-fast.
PHYSICS_REWARD_VERIFIER_FAILURE_POLICY=raise
